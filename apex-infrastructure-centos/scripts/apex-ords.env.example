# apex-ords.env  -- copy to /etc/apex-ords/apex-ords.env (chmod 600, root) and edit.
# NO SECRETS IN THIS FILE. Passwords are read at run time from stdin, a root-only
# file, or an OCI Vault secret (see ORDS_DB_PASSWORD_* below).

# ---- versions / locations -------------------------------------------------
ORDS_URL="https://download.oracle.com/otn_software/java/ords/ords-latest.zip"
ORDS_HOME="/opt/oracle/ords"            # ORDS product (bin/ords, ords.war)
ORDS_CONFIG="/etc/ords/config"          # ORDS configuration directory
ORDS_USER="ords"                        # OS user that runs ORDS
JAVA_PKG=""                             # blank = auto (jdk-21-headful on OL7/OCI, java-21-openjdk-headless on EL8/9)
ORDS_HEAP_MB="320"                      # small hosts (1 GB) work with 256-384 MB
ORDS_HTTP_PORT="8080"                   # ORDS standalone (Jetty) listens on 127.0.0.1 only

# ---- database target ------------------------------------------------------
# DB_TYPE=adb   : Autonomous Database (customer-managed ORDS, TLS, no wallet needed when mTLS is off)
# DB_TYPE=local : Oracle Database 23ai Free / EE on host:port/service (ORDS + APEX installed in the DB)
DB_TYPE="adb"
# ADB: full TLS descriptor from OCI console -> Database connection -> TLS (use a _low or _tp service)
DB_CUSTOM_URL="jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.REGION.oraclecloud.com))(connect_data=(service_name=XXXX_dbname_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))"
# local DB:
DB_HOST="localhost"; DB_PORT="1521"; DB_SERVICE="FREEPDB1"

# ORDS runtime + PL/SQL gateway users (ADB: created by sql/adb-customer-managed-ords.sql)
ORDS_RUNTIME_USER="ORDS_PUBLIC_USER2"
ORDS_GATEWAY_USER="ORDS_PLSQL_GATEWAY2"

# Where install scripts get the runtime user's password (pick one):
#   ORDS_DB_PASSWORD_FILE=/etc/apex-ords/ords_runtime.pw    (root-only file, deleted after use is fine)
#   ORDS_DB_PASSWORD_OCI_SECRET=ocid1.vaultsecret...         (needs oci cli + instance principal / profile)
#   neither -> read from stdin
ORDS_DB_PASSWORD_FILE=""
ORDS_DB_PASSWORD_OCI_SECRET=""

# ---- web tier (nginx) -----------------------------------------------------
APEX_SERVER_NAME="apex.example.com"     # vhost name (Host header)
APEX_VERSION="26.1.5"                   # must match SELECT version_no FROM apex_release
# Where /i/ (APEX static files) come from:
#   cdn   : proxy to https://static.oracle.com/cdn/apex/$APEX_VERSION/  (no 400 MB images copy)
#   local : serve from $APEX_IMAGES_DIR (unzipped apex/images)
APEX_IMAGES_MODE="cdn"
APEX_IMAGES_DIR="/var/www/apex/images"
# Page the smoke test renders (an app login page works well). Blank = skip that check.
APEX_SMOKE_PAGE=""
# TLS: blank = generate a self-signed cert for $APEX_SERVER_NAME (fine behind Cloudflare/LB "Full")
TLS_CERT=""; TLS_KEY=""
