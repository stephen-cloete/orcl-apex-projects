#!/usr/bin/env bash
# Usage: eu-oci-vault-secret <secret-name>  — reads from the EU tenancy vault (profile EU, ~/.oci/eu/config)
set -euo pipefail; export SUPPRESS_LABEL_WARNING=True PATH="$HOME/.local/bin:$PATH"
CFG="${OCI_CLI_CONFIG_FILE:-$HOME/.oci/eu/config}"; T=$(sed -n 's/^tenancy=//p' "$CFG")
VAULT=${EU_VAULT_OCID:?set EU_VAULT_OCID}
N="$1"
SID=$(oci --config-file "$CFG" --profile EU vault secret list --compartment-id "$T" --vault-id "$VAULT" --name "$N" --lifecycle-state ACTIVE --query 'data[0].id' --raw-output)
[[ -n "$SID" && "$SID" != null ]] || { echo "secret not found: $N" >&2; exit 1; }
oci --config-file "$CFG" --profile EU secrets secret-bundle get --secret-id "$SID" --query 'data."secret-bundle-content".content' --raw-output | base64 -d
